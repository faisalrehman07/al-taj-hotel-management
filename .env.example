# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (Default is 3000)
PORT=3000

# MongoDB Atlas connection string (Optional: if omitted, system falls back safely to durable storage)
MONGODB_URI=

# JWT and Session secret key for Admin authentication
AUTH_SECRET=

# Initial Admin credentials (can be set or defaulted)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Cloudinary image storage (required for Admin image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=al-taj-hotel
